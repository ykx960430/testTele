using "ui/basic.style";

downloadsBigPadding: margins(16px, 12px, 16px, 12px);

downloadsBigLayerWidth: 780px;

downloadsBigHeaderFont: font(13px semibold);
downloadsBigHeaderFg: windowBoldFg;
downloadsBigHeaderTop: 16px;
downloadsBigHeaderHeight: 30px;
downloadsBigHeaderBottom: 4px;

downloadsBigRowPadding: margins(12px, 12px, 12px, 12px);
downloadsBigRowBgOver: windowBgOver;

downloadsBigThumbSize: 48px;
downloadsBigThumbSkip: 12px;
downloadsBigThumbRadius: 10px;
downloadsBigThumbBg: windowBgOver;
downloadsBigThumbIcon: icon {{ "menu/download", windowSubTextFg }};

downloadsBigNameFont: font(14px semibold);
downloadsBigNameFg: windowFg;
downloadsBigStatusFont: font(12px);
downloadsBigStatusFg: windowSubTextFg;
downloadsBigStatusTop: 4px;
downloadsBigProgressHeight: 3px;
downloadsBigProgressTop: 4px;
downloadsBigProgressBg: windowBgOver;
downloadsBigProgressFg: activeLineFg;

downloadsBigActionSize: 32px;
downloadsBigActionSkip: 8px;
downloadsBigActionRadius: 8px;
downloadsBigActionBgOver: windowBgOver;
downloadsBigActionPause: icon {{ "history_file_pause", windowSubTextFg }};
downloadsBigActionResume: icon {{ "history_file_play", windowSubTextFg }};

downloadsBigThumbBadgeSize: 22px;
downloadsBigThumbBadgeRadius: 11px;
downloadsBigThumbBadgeBg: windowBg;

downloadsBigToggleSize: 12px;
downloadsBigToggle: icon {{ "history_down_arrow", windowSubTextFg }};

downloadsBigEmptyTop: 72px;
downloadsBigEmptyFont: font(14px);
downloadsBigEmptyFg: windowSubTextFg;

downloadsBigBarHeight: 46px;
downloadsBigBarBg: windowBg;
downloadsBigBarPadding: margins(16px, 0px, 16px, 0px);
downloadsBigBarBorder: 1px;
downloadsBigBarBorderFg: windowBgOver;
downloadsBigBarButtonFont: font(13px semibold);
downloadsBigBarButtonPadding: margins(14px, 8px, 14px, 8px);
downloadsBigBarButtonRadius: 8px;
downloadsBigBarButtonSkip: 8px;
downloadsBigBarButtonFg: activeButtonFg;
downloadsBigBarButtonFgOver: activeButtonFgOver;
downloadsBigBarButtonFgDisabled: windowSubTextFg;
downloadsBigBarButtonBgOver: windowBgOver;

downloadsBigStatsHeight: 68px;
downloadsBigStatsSkip: 8px;
downloadsBigStatsRadius: 10px;
downloadsBigStatsBg: windowBgOver;
downloadsBigStatsPadding: margins(12px, 10px, 12px, 10px);
downloadsBigStatsIconSize: size(24px, 24px);
downloadsBigStatsIconSkip: 10px;
downloadsBigStatsLabelFont: font(12px);
downloadsBigStatsLabelFg: windowSubTextFg;
downloadsBigStatsLabelSkip: 2px;
downloadsBigStatsValueFont: font(14px semibold);
downloadsBigStatsValueFg: windowFg;
downloadsBigStatsIconTotal: icon {{ "history_file_download", windowSubTextFg }};
downloadsBigStatsIconVideo: icon {{ "media_video_play", windowSubTextFg }};
downloadsBigStatsIconImage: icon {{ "history_file_image", windowSubTextFg }};
